<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>course_bringup</name>
  <version>0.0.0</version>
  <description>Bringup: turtlesim, patrol, pose_relay, pose_listener, MCAP recording</description>
  <maintainer email="kirillov2255@yandex.ru">Eugen</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>turtle_bringup</depend>
  <depend>patrol</depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>turtlesim_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
